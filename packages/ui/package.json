{
  "name": "@onetaskgraph/ui",
  "version": "0.0.0",
  "description": "React components for showing onetaskgraph tasks",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nickderobertis/onetaskgraph-ui.git",
    "directory": "packages/ui"
  },
  "type": "module",
  "sideEffects": [
    "./dist/styles.css"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown --fail-on-warn",
    "test": "bun test",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "peerDependencies": {
    "react": ">=18.3.0 <20",
    "react-dom": ">=18.3.0 <20"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^21.0.4",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "happy-dom": "^21.0.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsdown": "^0.22.14",
    "typescript": "6.0.3"
  }
}

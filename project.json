{
  "name": "repo",
  "$schema": "./node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "root": ".",
  "tags": ["scope:repo", "type:tooling"],
  "implicitDependencies": ["ui"],
  "targets": {
    "test": {
      "command": "bun test --timeout 60000 scripts/test",
      "dependsOn": ["^build"],
      "inputs": [
        "testInputs",
        "^testInputs",
        {
          "runtime": "node -p process.platform"
        }
      ],
      "outputs": []
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "bunx biome check --error-on-warnings scripts .releaserc.json gh-secrets.json biome.json tsconfig.base.json package.json project.json",
          "shellcheck scripts/release-probe.sh",
          "bunx github-actionlint"
        ],
        "parallel": false
      }
    },
    "format": {
      "command": "bunx biome check --write scripts .releaserc.json gh-secrets.json biome.json tsconfig.base.json package.json project.json"
    },
    "typecheck": {
      "command": "bunx tsc --noEmit -p scripts/tsconfig.json"
    }
  },
  "namedInputs": {
    "testInputs": ["npmTestInputs", "{projectRoot}/**/*"]
  }
}
